---
export interface Props {
  src: string;
  alt: string;
  aspectRatio?: string;
  hoverScale?: boolean;
}

const { src, alt, aspectRatio = 'aspect-[4/5]', hoverScale = true } = Astro.props;
---

<div class={`${aspectRatio} overflow-hidden shadow-2xl rounded-sm`}>
  <img
    {src}
    {alt}
    class={`w-full h-full object-cover ${hoverScale ? 'hover:scale-105 transition-transform duration-1000' : ''}`}
    loading="lazy"
  />
</div>