---
export interface Props {
  label: string;
  centered?: boolean;
}

const { label, centered = false } = Astro.props;
---

<div class="flex items-center gap-4" class:list={{ 'justify-center': centered }}>
  <span class="h-px w-8 bg-outline-variant dark:bg-outline"></span>
  <span class="font-label-md text-label-md text-outline dark:text-outline-dim uppercase tracking-[0.2em]">{label}</span>
  {centered && <span class="h-px w-8 bg-outline-variant dark:bg-outline"></span>}
</div>