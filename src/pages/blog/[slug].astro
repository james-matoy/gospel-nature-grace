---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const category = post.data.category || 'Reflection';
const readingTime = 5;
---

<BaseLayout title={post.data.title} description={`${category} &mdash; ${post.data.description || post.data.title}`} currentPath="/blog">
  <!-- Article Hero -->
  <section class="relative pt-32 pb-16 px-6">
    <div class="max-w-[800px] mx-auto text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="h-px w-6 bg-outline-variant dark:bg-outline"></span>
        <span class="font-label-md text-label-md text-secondary dark:text-[#bba286] uppercase tracking-[0.15em]">{category}</span>
        <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">&middot;</span>
        <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">{readingTime} min read</span>
      </div>
      <h1 class="font-display-lg-mobile md:text-display-lg text-primary dark:text-[#8cab8e] text-balance leading-tight mb-6">
        {post.data.title}
      </h1>
      <time datetime={post.data.date.toISOString()} class="font-label-md text-label-md text-outline dark:text-[#a4a8a3] italic">
        {post.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </div>
  </section>

  {post.data.cover && (
    <div class="max-w-[1000px] mx-auto px-6 mb-16">
      <div class="aspect-[16/9] overflow-hidden rounded-sm">
        <img
          src={post.data.cover}
          alt={post.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  )}

  <!-- Article Content -->
  <article class="max-w-[740px] mx-auto px-6 pb-32">
    <div class="prose prose-gray max-w-none font-body-lg text-body-lg text-on-surface-variant dark:text-[#a2a9a2] leading-relaxed space-y-6
      prose-headings:font-headline-md prose-headings:text-headline-md prose-headings:text-primary dark:prose-headings:text-[#8cab8e] prose-headings:leading-tight prose-headings:mt-12 prose-headings:mb-6
      prose-a:text-primary dark:prose-a:text-[#8cab8e] prose-a:underline decoration-primary/30 dark:decoration-[#8cab8e]/30 prose-a:underline-offset-4 prose-a:transition-all hover:prose-a:decoration-primary dark:hover:prose-a:decoration-[#8cab8e]
      prose-blockquote:border-l-4 prose-blockquote:border-secondary dark:prose-blockquote:border-secondary-fixed-dim prose-blockquote:pl-6 prose-blockquote:font-headline-md prose-blockquote:text-headline-sm prose-blockquote:text-primary dark:prose-blockquote:text-[#8cab8e] prose-blockquote:leading-relaxed prose-blockquote:italic
      prose-strong:text-on-surface dark:prose-strong:text-inverse-on-surface prose-strong:font-bold
      prose-code:text-secondary dark:prose-code:text-secondary-fixed-dim prose-code:bg-surface-container-high dark:prose-code:bg-surface-container-higher prose-code:px-2 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-sm
      prose-img:rounded-sm prose-img:w-full
      prose-hr:border-outline-variant/30 dark:prose-hr:border-outline/30
      prose-li:marker:text-primary dark:prose-li:marker:text-[#8cab8e]
    ">
      <Content />
    </div>

    <!-- Navigation back -->
    <div class="mt-20 pt-8 border-t border-outline-variant/30 dark:border-outline/30 flex justify-between items-center">
      <a href="/blog" class="inline-flex items-center gap-2 font-label-md text-label-md text-primary dark:text-[#92af94] group">
        <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">chevron_left</span>
        <span class="border-b border-primary/30 dark:border-[#92af94]/30 group-hover:border-primary dark:group-hover:border-[#92af94] transition-all">Back to Reflections</span>
      </a>
      <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">{post.data.date.toLocaleDateString('en-US', { year: 'numeric' })}</span>
    </div>
  </article>
</BaseLayout>