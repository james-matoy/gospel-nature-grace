---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = (await getCollection('categories')).filter(cat => cat.data.name);
---

<BaseLayout title="Written Word" description="Reflections on Gospel, Nature, and Grace" currentPath="/blog">
  <!-- Hero / Page Title -->
  <section class="relative pt-32 pb-24 px-6 text-center">
    <div class="max-w-[800px] mx-auto">
      <h1 class="font-display-lg-mobile md:text-display-lg text-primary dark:text-[#8cab8e] text-balance mb-6">
        Written Word
      </h1>
      <p class="font-headline-sm italic text-tertiary dark:text-tertiary-fixed-dim leading-relaxed opacity-90 max-w-xl mx-auto">
        &ldquo;In the beginning was the Word, and the Word was with God, and the Word was God.&rdquo;<br />
        <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">&mdash; John 1:1</span>
      </p>
    </div>
  </section>

  <!-- Sticky Search & Filter Controls -->
  <div class="sticky top-16 z-40 bg-surface/90 dark:bg-on-background/90 backdrop-blur-md border-b border-outline-variant/40 dark:border-outline/40 transition-colors">
    <div class="max-w-[1000px] mx-auto px-6 py-4 flex items-center gap-4 overflow-x-auto no-scrollbar">
      <div class="relative flex-1 min-w-[200px]">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline dark:text-[#a4a8a3] text-sm">search</span>
        <input
          type="text"
          placeholder="Search reflections..."
          class="w-full pl-10 pr-4 py-2.5 bg-surface-container-high dark:bg-surface-container-highest text-on-surface dark:text-inverse-on-surface border-none outline-none font-body-md text-body-md placeholder:text-outline dark:placeholder:text-[#a4a8a3] transition-colors"
        />
      </div>
      <div class="flex gap-2 flex-shrink-0">
        <button data-category="all" class="category-btn font-label-md text-label-md px-4 py-2.5 whitespace-nowrap bg-primary dark:bg-primary-fixed-dim text-on-primary dark:text-on-primary-fixed transition-colors">All Reflections</button>
        {
          categories.map((cat) => (
            <button data-category={cat.data.name} class="category-btn font-label-md text-label-md px-4 py-2.5 whitespace-nowrap text-outline dark:text-[#a4a8a3] hover:bg-surface-container-high dark:hover:bg-surface-container-highest transition-colors">
              {cat.data.name}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <main class="max-w-[1000px] mx-auto px-6 py-16 space-y-16">
    {
      posts.length === 0 ? (
        <p class="text-center font-body-lg text-body-lg text-outline dark:text-[#a4a8a3] py-24">
          No reflections yet. The first leaf has yet to fall&hellip;
        </p>
      ) : (
        posts.map((post, index) => (
          <article data-category={post.data.category || 'Reflection'} class="reveal grid grid-cols-1 md:grid-cols-2 gap-10 items-center" style={`transition-delay: ${index * 100}ms`}>
            <div class={`${index % 2 === 0 ? 'order-2 md:order-1' : 'order-2 md:order-2'}`}>
              {post.data.cover ? (
                <div class="aspect-[16/9] overflow-hidden rounded-sm">
                  <img
                    src={post.data.cover}
                    alt={post.data.title}
                    class="w-full h-full object-cover grayscale hover:grayscale-0 hover:scale-105 transition-all duration-700"
                  />
                </div>
              ) : (
                <div class="aspect-[16/9] bg-surface-container-high dark:bg-surface-container-highest rounded-sm flex items-center justify-center">
                  <span class="material-symbols-outlined text-outline dark:text-[#a4a8a3] text-4xl">auto_stories</span>
                </div>
              )}
            </div>
            <div class={`${index % 2 === 0 ? 'order-1 md:order-2' : 'order-1 md:order-1'} space-y-6`}>
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <span class="h-px w-6 bg-outline-variant dark:bg-outline"></span>
                  <span class="font-label-md text-label-md text-secondary dark:text-[#bba286] uppercase tracking-[0.15em]">
                    {post.data.category || 'Reflection'}
                  </span>
                  <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">&middot;</span>
                <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">
                    5 min read
                  </span>
                </div>
                <h2 class="font-headline-md text-headline-md text-primary dark:text-[#8cab8e] leading-tight">
                  <a href={`/blog/${post.id}`} class="hover:underline decoration-primary/30 dark:decoration-[#8cab8e]/30 underline-offset-4 transition-all">
                    {post.data.title}
                  </a>
                </h2>
              </div>
              <p class="font-body-md text-body-md text-on-surface-variant dark:text-[#a2a9a2] leading-relaxed line-clamp-3">
                {post.data.description || post.data.title}
              </p>
              <div class="flex items-center gap-4">
                <time datetime={post.data.date.toISOString()} class="font-label-md text-label-md text-outline dark:text-[#a4a8a3]">
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center gap-2 font-label-md text-label-md text-primary dark:text-[#8cab8e] group"
                  >
                    <span class="border-b border-primary/30 dark:border-[#8cab8e]/30 group-hover:border-primary dark:group-hover:border-[#8cab8e] transition-all">Read Reflection</span>
                  <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </a>
              </div>
            </div>
          </article>
        ))
    )
  }
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.category-btn');
      const posts = document.querySelectorAll('article[data-category]');
      const searchInput = document.querySelector('input[type="text"]');

      function getCategory() {
        const active = document.querySelector('.category-btn.bg-primary');
        return active ? active.dataset.category : 'all';
      }

      function filterPosts(category, query) {
        document.querySelectorAll('.category-btn').forEach(btn => {
          btn.classList.remove('bg-primary', 'dark:bg-primary-fixed-dim', 'text-on-primary', 'dark:text-on-primary-fixed');
          btn.classList.add('text-outline', 'dark:text-[#a4a8a3]');
        });

        const activeBtn = document.querySelector(`.category-btn[data-category="${CSS.escape(category)}"]`);
        if (activeBtn) {
          activeBtn.classList.remove('text-outline', 'dark:text-[#a4a8a3]');
          activeBtn.classList.add('bg-primary', 'dark:bg-primary-fixed-dim', 'text-on-primary', 'dark:text-on-primary-fixed');
        }

        const q = (query || '').toLowerCase();
        posts.forEach(post => {
          const postCat = post.dataset.category || 'Reflection';
          const title = (post.querySelector('h2')?.textContent || '').toLowerCase();
          const matchesCategory = category === 'all' || postCat === category;
          const matchesQuery = title.includes(q);
          post.style.display = (matchesCategory && matchesQuery) ? '' : 'none';
        });
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => filterPosts(btn.dataset.category, searchInput?.value));
      });

      if (searchInput) {
        searchInput.addEventListener('input', () => filterPosts(getCategory(), searchInput.value));
      }

      filterPosts('all');
    });
  </script>
