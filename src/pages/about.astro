---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionDivider from '../components/SectionDivider.astro';
import ImageCard from '../components/ImageCard.astro';
import BlockQuote from '../components/BlockQuote.astro';
import { Image } from 'astro:assets';
---

<BaseLayout title="About" description="About James David Matoy &mdash; Gospel, Nature, and Grace" currentPath="/about">
  <PageHero
    title="About the Author"
    quote="&ldquo;The ground of all being is revealed in the soil beneath our feet.&rdquo;"
  />

  <main class="max-w-[1000px] mx-auto px-6 pb-32 space-y-32">
    <!-- Bio Section -->
    <section class="reveal grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <!-- Author Portrait -->
      <div class="relative md:sticky md:top-28">
        <ImageCard
          src="/images/about/profile.webp"
          alt="James David Matoy portrait"
          loading="eager"
        />
        <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/10 dark:bg-primary-fixed-dim/10 rounded-full -z-10"></div>
      </div>

      <!-- Bio Text -->
      <div class="space-y-8">
        <div class="space-y-4">
          <SectionDivider label="The Steward" />
          <h2 class="font-headline-md text-headline-md text-primary dark:text-primary-dim leading-tight">
            James David Matoy
          </h2>
          <p class="font-label-md text-label-md text-outline dark:text-outline-dim italic">Writer, Data Engineer, Servant of the Word</p>
        </div>

        <div class="space-y-6 font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant-dim leading-relaxed">
          <p>
            James David Matoy is a writer and student of Scripture who believes that faith is not contained within the walls of a church — it breathes through the world God made, through the silence of a trail walk, the weight of a difficult season, and the grace that keeps showing up anyway.
          </p>
          <p>
            By profession, he works in data and AI automation. By conviction, he is a man learning to walk in the Spirit — slowly, honestly, and with daily repentance. He holds a degree in Mathematics and spent years building systems that help organizations make sense of their data. But the work that matters most to him cannot be measured in pipelines or dashboards. It is the work of knowing Jesus more, following Him more closely, and becoming more like Him.
          </p>
          <p>
            This blog — Gospel, Nature, and Grace — began not as a platform but as a need. After months of silence, God convicted him to write again. So he built a place where those writings could live: not scattered across a social media feed, but gathered and kept, the way you keep a journal you mean to return to.
          </p>
          <p>
            James lives in Davao City, Philippines. He walks the trails of Shrine Hills and GSIS Heights when he needs to think. He studies the Bible the way he approaches hard problems — carefully, repeatedly, with genuine questions. He writes because it draws him closer to God, and because he believes the things God says to one person in the quiet of their own journey might one day speak to someone else in theirs.
          </p>
          <p>
            This blog is the place where God and I meet.
          </p>
        </div>
      </div>
    </section>

    <!-- Inset Blockquote -->
    <div class="reveal max-w-3xl mx-auto">
      <BlockQuote
        quote="&ldquo;God convicts me to write. Not because I have answers, but because writing draws me closer to Him &mdash; it clears my mind, moves me to pray, and makes His Word my life. This blog is not a platform. It is the place where God and I meet.&rdquo;"
        attribution="James David Matoy"
        attributionEmphasis="Gospel, Nature, and Grace"
      />
    </div>

    <!-- Agricultural Mosaic / Cycle of Growth -->
    <section class="reveal space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <SectionDivider label="The Cycle of Growth" centered />
        <h2 class="font-headline-md text-headline-md text-primary dark:text-primary-dim">
          Agricultural Mosaic
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant dark:text-on-surface-variant-dim leading-relaxed">
          The spiritual life, like the agrarian year, moves through seasons of preparation, planting, cultivation, and harvest&mdash;each with its own kind of grace.
        </p>
      </div>

      <!-- Image Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Planting -->
        <div class="group relative overflow-hidden rounded-sm aspect-[4/5] cursor-pointer">
          <Image
            alt="Planting seeds in rich soil"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="/images/about/planting.webp"
            width={800}
            height={1000}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="font-label-md text-label-md text-primary-fixed-dim tracking-widest uppercase">Planting</span>
            <h3 class="font-headline-sm text-headline-sm text-white mt-1">Seeds of Intention</h3>
          </div>
        </div>

        <!-- Cultivating -->
        <div class="group relative overflow-hidden rounded-sm aspect-[4/5] cursor-pointer">
          <Image
            alt="Tending a garden"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="/images/about/cultivating.webp"
            width={800}
            height={1000}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="font-label-md text-label-md text-primary-fixed-dim tracking-widest uppercase">Cultivating</span>
            <h3 class="font-headline-sm text-headline-sm text-white mt-1">Patience & Prayer</h3>
          </div>
        </div>

        <!-- Bearing Fruit -->
        <div class="group relative overflow-hidden rounded-sm aspect-[4/5] cursor-pointer">
          <Image
            alt="Harvest of fruits"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="/images/about/bearing-fruit.webp"
            width={800}
            height={1000}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="font-label-md text-label-md text-primary-fixed-dim tracking-widest uppercase">Bearing Fruit</span>
            <h3 class="font-headline-sm text-headline-sm text-white mt-1">The Harvest of Grace</h3>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>