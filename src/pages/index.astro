---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="Sanctuary for the Written Word" currentPath="/">
  <!-- Hero Section -->
  <section class="relative flex items-center justify-center pt-20 min-h-[75vh]">
    <div class="absolute inset-0 z-0">
      <img
        alt="Mountain summit landscape at dawn"
        class="w-full h-full object-cover"
        src="/images/pages/home/hero-bg.webp"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="absolute inset-0 atmospheric-overlay"></div>
    </div>
    <div class="relative z-10 text-center max-w-[800px] px-6">
      <h1 class="font-display-lg-mobile md:text-display-lg text-primary dark:text-[#8cab8e] text-balance mb-8">
        Gospel, Nature, and Grace
      </h1>
      <p class="font-headline-sm italic text-tertiary dark:text-tertiary-fixed-dim leading-relaxed text-balance opacity-90 max-w-xl mx-auto">
        &ldquo;Finding the divine in the deep textures of the world, where silence speaks and every leaf whispers of a Creator's hand.&rdquo;
      </p>
      <div class="mt-16">
        <a href="/blog">
          <button
            class="font-label-md text-label-md text-primary dark:text-[#8cab8e] tracking-widest uppercase border-b-2 border-primary/20 dark:border-[#8cab8e]/20 pb-2 hover:border-primary dark:hover:border-[#8cab8e] transition-all"
          >
            Enter the Sanctuary
          </button>
        </a>
      </div>
    </div>
  </section>

  <main class="max-w-[1000px] mx-auto px-6 py-section-gap space-y-40">
    <!-- Pinned Spotlight -->
    <article class="reveal grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div class="order-2 md:order-1">
        <div class="aspect-[3/4] overflow-hidden shadow-2xl rounded-sm">
          <img
            alt="Ancient gnarled olive tree"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000"
            src="/images/pages/home/spotlight.webp"
            width="600"
            height="800"
            loading="lazy"
          />
        </div>
      </div>
      <div class="order-1 md:order-2 space-y-10">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <span class="h-px w-8 bg-outline-variant dark:bg-outline"></span>
            <span class="font-label-md text-label-md text-outline dark:text-[#a4a8a3] uppercase tracking-[0.2em]">Featured Reflection</span>
          </div>
          <h2 class="font-headline-md text-headline-md text-primary dark:text-[#8cab8e] leading-tight">
            The Liturgy of the Leaves: A Theology of Ancient Roots
          </h2>
          <p class="font-label-md text-label-md text-outline dark:text-[#a4a8a3] italic">Autumn Equinox, 2024</p>
        </div>
        <div class="space-y-6">
          <p class="font-body-lg text-body-lg text-on-surface-variant dark:text-[#a2a9a2] leading-relaxed first-letter:text-6xl first-letter:font-headline-md first-letter:mr-3 first-letter:float-left first-letter:text-primary dark:first-letter:text-[#8cab8e]">
            In the profound silence of the deep orchard, one discovers a different kind of prayer. It is not spoken in words, but in the rhythmic sway of silver-green boughs and the persistent growth of bark over centuries. Grace is not an abstract concept here; it is the very endurance of the wild.
          </p>
          <a
            class="inline-flex items-center gap-3 font-label-md text-label-md text-primary dark:text-[#8cab8e] group"
            href="/blog"
          >
            <span class="border-b border-primary/30 dark:border-[#8cab8e]/30 group-hover:border-primary dark:group-hover:border-[#8cab8e] transition-all">Read the full reflection</span>
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Secondary Asset: The Forest Path -->
    <section class="reveal relative group cursor-pointer overflow-hidden rounded-sm">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch bg-surface-container-low dark:bg-surface-container-high transition-colors">
        <div class="md:col-span-7 p-12 md:p-20 flex flex-col justify-center space-y-8">
          <span class="font-label-md text-label-md text-secondary dark:text-secondary-fixed-dim tracking-widest uppercase">The Deep Woods</span>
          <h2 class="font-headline-md text-primary dark:text-[#8cab8e]">Sanctuary of the Pine</h2>
          <p class="font-body-md text-on-surface-variant dark:text-[#a2a9a2] leading-relaxed">
            Where sunlight filters through a cathedral of canopy, we learn the quiet art of listening. These forests are not merely timber and moss, but living testaments to the steady, unhurried pace of Divine work.
          </p>
          <div class="pt-4">
            <a href="/blog">
              <button class="font-label-md text-label-md px-8 py-3 bg-primary dark:bg-primary-fixed-dim text-on-primary dark:text-on-primary-fixed hover:bg-primary-container transition-colors">
                Explore the Forest
              </button>
            </a>
          </div>
        </div>
        <div class="md:col-span-5 relative h-[400px] md:h-auto overflow-hidden">
          <img
            alt="Sunlight filtering through forest trees"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="/images/pages/home/forest-path.webp"
            width="600"
            height="600"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Philosophic Quote -->
    <div class="reveal py-24 text-center max-w-2xl mx-auto border-y border-outline-variant/30 dark:border-outline/30">
      <blockquote class="font-headline-md text-headline-sm italic text-primary dark:text-[#8cab8e] leading-relaxed">
        &ldquo;We do not study nature to master it, but to learn the language of the Creator written in every fiber and leaf.&rdquo;
      </blockquote>
      <p class="mt-8 font-label-md text-label-md text-outline dark:text-[#a4a8a3] uppercase tracking-widest">&mdash; From the Archives of Grace</p>
    </div>
  </main>
</BaseLayout>