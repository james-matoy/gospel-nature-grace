---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description, currentPath = '/' } = Astro.props;
const isHome = currentPath === '/';
const isBlog = currentPath.startsWith('/blog');
const isAbout = currentPath === '/about';
---

<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark') document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title} | Gospel, Nature, and Grace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
      media="print" onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    </noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
      media="print" onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    </noscript>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {isHome && <link rel="preload" as="image" href="/images/pages/home/hero-bg.webp" fetchpriority="high" />}
    <slot name="head" />
  </head>
  <body
    class="text-on-background dark:text-inverse-on-surface selection:bg-primary-container selection:text-on-primary-container transition-colors duration-300"
  >
    <!-- Top Navigation -->
    <header
      class="fixed top-0 w-full z-50 flex justify-between items-center px-6 h-16 md:px-12 bg-surface/80 dark:bg-on-background/80 backdrop-blur-md transition-colors"
    >
      <div class="flex items-center gap-6">
        <span
          class="material-symbols-outlined text-primary dark:text-inverse-primary cursor-pointer md:hidden"
          id="mobile-menu-btn"
        >menu</span>
        <a
          class="font-headline-md text-primary dark:text-inverse-primary tracking-tight text-[24px] md:text-[32px]"
          href="/"
        >Gospel, Nature, and Grace</a>
      </div>
      <nav class="hidden md:flex items-center gap-10">
        <a
          href="/"
          class="font-label-md text-label-md text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim transition-colors"
          class:list={{ 'text-primary dark:text-inverse-primary border-b border-primary dark:border-inverse-primary': isHome, 'text-outline dark:text-outline-dim': !isHome }}
        >HOME</a>
        <a
          href="/blog"
          class="font-label-md text-label-md transition-colors"
          class:list={{ 'text-primary dark:text-inverse-primary border-b border-primary dark:border-inverse-primary': isBlog, 'text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim': !isBlog }}
        >REFLECTIONS</a>
        <a
          href="/about"
          class="font-label-md text-label-md transition-colors"
          class:list={{ 'text-primary dark:text-inverse-primary border-b border-primary dark:border-inverse-primary': isAbout, 'text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim': !isAbout }}
        >ABOUT</a>
        <a
          href="/contact"
          class="font-label-md text-label-md transition-colors"
          class:list={{ 'text-primary dark:text-inverse-primary border-b border-primary dark:border-inverse-primary': currentPath === '/contact', 'text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim': currentPath !== '/contact' }}
        >CONTACT</a>
      </nav>
      <div class="flex items-center gap-4">
        <button
          aria-label="Toggle dark mode"
          class="p-2 text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim transition-colors"
          id="theme-toggle"
        >
          <span class="material-symbols-outlined">dark_mode</span>
        </button>
      </div>
    </header>

    <slot />

    <!-- Footer -->
    <footer
      class="w-full py-section-gap px-margin-mobile flex flex-col items-center text-center space-y-4 bg-surface dark:bg-on-background border-t border-outline-variant dark:border-outline transition-colors"
    >
      <div
        class="max-w-[1000px] mx-auto flex flex-col items-center text-center space-y-12 w-full"
      >
        <div class="space-y-4">
          <h2
            class="font-headline-sm text-headline-sm text-primary dark:text-primary-fixed-dim"
          >Gospel, Nature, and Grace</h2>
          <p
            class="font-body-md text-outline dark:text-outline-dim max-w-md mx-auto italic"
          >A contemplative journal exploring the intersection of spiritual truth and the natural world.</p>
        </div>
        <div class="flex gap-12 flex-wrap justify-center">
          <a
            href="/blog"
            class="font-body-md text-body-md text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim underline transition-colors"
          >Archives</a>
          <a
            href="#"
            class="font-body-md text-body-md text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim underline transition-colors"
          >Terms of Grace</a>
          <a
            href="/contact"
            class="font-body-md text-body-md text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim underline transition-colors"
          >Contact</a>
        </div>
        <div class="pt-8 space-y-2">
          <p
            class="font-body-md text-body-md text-outline dark:text-outline-dim opacity-70"
          >© 2026 Gospel, Nature, and Grace. Soli Deo Gloria.</p>
          <div class="flex justify-center gap-4 text-outline-variant dark:text-outline">
            <span class="material-symbols-outlined text-sm">nature</span>
            <span class="material-symbols-outlined text-sm">auto_stories</span>
            <span class="material-symbols-outlined text-sm">water_drop</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Nav -->
    <nav
      class="fixed bottom-0 w-full z-50 flex justify-around items-center py-4 bg-surface dark:bg-on-background border-t border-outline-variant dark:border-outline md:hidden transition-colors"
    >
      <a
        href="/"
        class="flex flex-col items-center justify-center gap-1 active:scale-95 transition-transform"
        class:list={{ 'text-primary dark:text-primary-fixed-dim font-bold': isHome, 'text-outline dark:text-outline-dim': !isHome }}
      >
        <span class="material-symbols-outlined" class:list={{ 'font-variation-settings': "'FILL' 1" }}>home_max</span>
        <span class="text-[10px] uppercase font-label-md tracking-tighter">Home</span>
      </a>
      <a
        href="/blog"
        class="flex flex-col items-center justify-center gap-1 active:scale-95 transition-all"
        class:list={{ 'text-primary dark:text-primary-fixed-dim font-bold': isBlog, 'text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim': !isBlog }}
      >
        <span class="material-symbols-outlined">auto_stories</span>
        <span class="text-[10px] uppercase font-label-md tracking-tighter">Reflections</span>
      </a>
      <a
        href="/about"
        class="flex flex-col items-center justify-center gap-1 active:scale-95 transition-all"
        class:list={{ 'text-primary dark:text-primary-fixed-dim font-bold': isAbout, 'text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim': !isAbout }}
      >
        <span class="material-symbols-outlined">nature_people</span>
        <span class="text-[10px] uppercase font-label-md tracking-tighter">About</span>
      </a>
      <a
        href="/contact"
        class="flex flex-col items-center justify-center gap-1 active:scale-95 transition-all"
        class:list={{ 'text-primary dark:text-primary-fixed-dim font-bold': currentPath === '/contact', 'text-outline dark:text-outline-dim hover:text-primary dark:hover:text-primary-fixed-dim': currentPath !== '/contact' }}
      >
        <span class="material-symbols-outlined">mail</span>
        <span class="text-[10px] uppercase font-label-md tracking-tighter">Contact</span>
      </a>
    </nav>

    <script>
      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          html.classList.toggle('dark');
          const isDark = html.classList.contains('dark');
          const icon = themeToggle.querySelector('span');
          if (icon) icon.textContent = isDark ? 'light_mode' : 'dark_mode';
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
        });
      }

      // Sticky Header scroll effect
      window.addEventListener('scroll', () => {
        const header = document.querySelector('header');
        if (header) {
          if (window.scrollY > 20) {
            header.classList.add('shadow-md');
          } else {
            header.classList.remove('shadow-md');
          }
        }
      });

      // Scroll reveal animation
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>